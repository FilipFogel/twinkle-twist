<?xml version="1.0" encoding="utf-8"?>
<!-- Test shell without the ads SDK. Its own package name, so it does not clash with the real app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.twinkletwist.game.test"
    android:versionCode="1"
    android:versionName="1.0.0-test">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.TwinkleTwist">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
